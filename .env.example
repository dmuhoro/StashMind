# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime or set to your custom domain / preview URL.
APP_URL="http://localhost:3000"

# Supabase Configuration (Phase 1 gate)
# SUPABASE_URL: URL of your Supabase project instance (https://<project-ref>.supabase.co)
SUPABASE_URL="https://example.supabase.co"
# SUPABASE_ANON_KEY: Client-safe publishable anonymous key (for client browser RLS access)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# SUPABASE_SERVICE_ROLE_KEY: Server-only key with bypass privileges (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Cost & Safety Controls
# DAILY_SPEND_KILL_SWITCH: When 'true', immediately disables TTS and heavy model calls, falling back to text-only mode
DAILY_SPEND_KILL_SWITCH="false"
# DAILY_USER_LESSON_CAP: Maximum lessons a user can generate per calendar day on free tier
DAILY_USER_LESSON_CAP="5"

# Integration & Webhooks
# WEBHOOK_SIGNING_SECRET: Secret key used to sign outgoing webhook payloads with HMAC-SHA256
WEBHOOK_SIGNING_SECRET="whsec_example_secret_for_hmac_sha256"
ANTHROPIC_API_KEY=
GROQ_API_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
KOKORO_BASE_URL=
MPESA_DARAJA_BASE_URL=
MPESA_DARAJA_CALLBACK_URL=
MPESA_DARAJA_CONSUMER_KEY=
MPESA_DARAJA_CONSUMER_SECRET=
MPESA_DARAJA_PASSKEY=
MPESA_DARAJA_SHORTCODE=
NODE_ENV=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
PIPER_BINARY=
PIPER_MODEL=
PORT=
TELEGRAM_BOT_TOKEN=
